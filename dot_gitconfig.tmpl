[user]
  email = {{ .email }} 
  name = {{ .name }}
[core]
  editor = vim
  excludesfile = ~/.gitignore
[push]
  autoSetupRemote = true
[alias]
  aa = add --all
  diffs = diff --staged
  st = status
  staash = stash --all
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
