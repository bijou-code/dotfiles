#!/usr/bin/env bash

set -e -o pipefail

usage() {
  echo "Usage: gb <branch-substring>" >&2
}

if [[ ${1:-} == --resolve ]]; then
  resolve=true
  shift
else
  resolve=false
fi

if [[ $# -ne 1 || -z $1 ]]; then
  usage
  exit 2
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "gb: not inside a Git repository" >&2
  exit 2
fi

query=$1
local_matches=()
remote_matches=()

while IFS=$'\t' read -r ref symref; do
  case $ref in
    refs/heads/*)
      branch=${ref#refs/heads/}
      [[ $branch == *"$query"* ]] && local_matches+=("$branch")
      ;;
    refs/remotes/*)
      branch=${ref#refs/remotes/}
      [[ -z $symref && $branch == *"$query"* ]] && remote_matches+=("$branch")
      ;;
  esac
done < <(git for-each-ref --format='%(refname)%09%(symref)' refs/heads refs/remotes)

if ! $resolve; then
  [[ ${#local_matches[@]} -gt 0 ]] && printf '%s\n' "${local_matches[@]}"
  [[ ${#remote_matches[@]} -gt 0 ]] && printf '%s\n' "${remote_matches[@]}"
  [[ ${#local_matches[@]} -gt 0 || ${#remote_matches[@]} -gt 0 ]] || exit 1
  exit 0
fi

# Prefer exact local and fully qualified remote refs.
for branch in "${local_matches[@]}"; do
  if [[ $branch == "$query" ]]; then
    printf 'local\t%s\n' "$branch"
    exit 0
  fi
done

exact_remote_matches=()
for branch in "${remote_matches[@]}"; do
  if [[ $branch == "$query" ]]; then
    printf 'remote\t%s\n' "$branch"
    exit 0
  elif [[ ${branch#*/} == "$query" ]]; then
    exact_remote_matches+=("$branch")
  fi
done

# An exact branch name wins over longer substring matches. If it exists on
# multiple remotes, require the caller to include the remote name.
if [[ ${#exact_remote_matches[@]} -eq 1 ]]; then
  printf 'remote\t%s\n' "${exact_remote_matches[0]}"
  exit 0
elif [[ ${#exact_remote_matches[@]} -gt 1 ]]; then
  echo "gb: '$query' exists on multiple remotes; use a fully qualified branch:" >&2
  printf '  %s\n' "${exact_remote_matches[@]}" >&2
  exit 2
fi

# With no exact match, prefer local substring matches over remote matches.
if [[ ${#local_matches[@]} -gt 0 ]]; then
  kind=local
  candidates=("${local_matches[@]}")
else
  kind=remote
  candidates=("${remote_matches[@]}")
fi

if [[ ${#candidates[@]} -eq 1 ]]; then
  printf '%s\t%s\n' "$kind" "${candidates[0]}"
  exit 0
elif [[ ${#candidates[@]} -eq 0 ]]; then
  echo "gb: no branch matches '$query'" >&2
  exit 1
fi

echo "gb: '$query' is ambiguous; matching branches:" >&2
printf '  %s\n' "${candidates[@]}" >&2
exit 2
